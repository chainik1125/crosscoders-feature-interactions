    "top_m_activations = get_top_activations(dataset, llm, crosscoders['crosscoder_M'], N=5, n_prompts=500)\n",
    "top_mf_activations = get_top_activations(dataset, llm, crosscoders['crosscoder_MF'], N=5, n_prompts=500)\n",
    "top_df_activations = get_top_activations(dataset, llm, crosscoders['crosscoder_DF'], N=5, n_prompts=500)\n",
    "\n",
    "top_activations = top_df_activations    # default for graphs"
   ]

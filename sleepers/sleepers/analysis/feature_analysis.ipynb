    "# Define numeric feature analysis functions\n",
    "\n",
    "def get_ft_quadrant(D_DF_cosine_sims, M_MF_cosine_sims, quadrant_percentile_threshold=5):\n",
    "    \"\"\"\n",
    "    Categorize features into quadrants based on cosine similarity thresholds.\n",
    "    \n",
    "    Args:\n",
    "        D_DF_cosine_sims: Cosine similarities between D and DF features\n",
    "        M_MF_cosine_sims: Cosine similarities between M and MF features\n",
    "        quadrant_percentile_threshold: Percentile threshold for defining quadrants (default: 5)\n",
    "    \n",
    "    Returns:\n",
    "        list: Quadrant assignment for each feature\n",
    "    \"\"\"\n",
    "    # Calculate thresholds\n",
    "    D_threshold = np.percentile(D_DF_cosine_sims, quadrant_percentile_threshold)\n",
    "    M_threshold = np.percentile(M_MF_cosine_sims, quadrant_percentile_threshold)\n",
    "    \n",
    "    ft_quadrants = []\n",
    "    for i in range(D_DF_cosine_sims.shape[0]):\n",
    "        # Assign quadrant based on thresholds\n",
    "        if D_DF_cosine_sims[i] < D_threshold and M_MF_cosine_sims[i] < M_threshold:\n",
    "            quadrant = 'max_change_DM'\n",
    "        elif D_DF_cosine_sims[i] < D_threshold:\n",
    "            quadrant = 'max_change_D'\n",
    "        elif M_MF_cosine_sims[i] < M_threshold:\n",
    "            quadrant = 'max_change_M'\n",
    "        else:\n",
    "            quadrant = 'min_change_DM'\n",
    "        \n",
    "        ft_quadrants.append(quadrant)\n",
    "    \n",
    "    return ft_quadrants\n",
    "\n",
    "def count_dead_quad_fts(ft_quadrants, top_activations_mini):\n",
    "    \"\"\"\n",
    "    Count dead and alive features in each quadrant.\n",
    "    \n",
    "    Args:\n",
    "        ft_quadrants: List of quadrant assignments\n",
    "        top_activations_mini: List of feature activations\n",
    "    \n",
    "    Returns:\n",
    "        dict: Counts of dead and alive features per quadrant\n",
    "    \"\"\"\n",
    "    ft_counts = {quad: {'dead': 0, 'alive': 0} for quad in set(ft_quadrants)}\n",
    "\n",
    "    for i, ft_acts in enumerate(top_activations_mini):\n",
    "        if len(ft_acts) == 0:\n",
    "            ft_counts[ft_quadrants[i]]['dead'] += 1\n",
    "        else:\n",
    "            ft_counts[ft_quadrants[i]]['alive'] += 1\n",
    "    \n",
    "    return ft_counts\n",
    "\n",
    "def count_relevant_features(ft_quadrants, top_activations, relevant_strings):\n",
    "    \"\"\"\n",
    "    Count features relevant to specific strings in each quadrant.\n",
    "    \n",
    "    Args:\n",
    "        ft_quadrants: List of quadrant assignments\n",
    "        top_activations: List of feature activations\n",
    "        relevant_strings: List of strings to check for relevance\n",
    "    \n",
    "    Returns:\n",
    "        dict: Counts of relevant features per string per quadrant\n",
    "    \"\"\"\n",
    "    quad_str_relevance_dict = {\n",
    "        quad: {string: 0 for string in relevant_strings} \n",
    "        for quad in set(ft_quadrants)\n",
    "    }\n",
    "    \n",
    "    for i, ft_acts in enumerate(top_activations):\n",
    "        activation_strings = get_token_strings(ft_acts)\n",
    "        for string in relevant_strings:\n",
    "            if all(activation_string in string for activation_string in activation_strings):\n",
    "                if any(len(activation_string) > 1 for activation_string in activation_strings):\n",
    "                    quad_str_relevance_dict[ft_quadrants[i]][string] += 1\n",
    "    \n",
    "    return quad_str_relevance_dict\n",
    "\n",
    "def eval_relevant_ft_overlap(ft_quadrants, top_activations1, top_activations2, relevant_strings):\n",
    "    \"\"\"\n",
    "    Evaluate overlap between relevant features in two sets of activations.\n",
    "    \n",
    "    Args:\n",
    "        ft_quadrants: List of quadrant assignments\n",
    "        top_activations1: First set of feature activations\n",
    "        top_activations2: Second set of feature activations\n",
    "        relevant_strings: List of strings to check for relevance\n",
    "    \n",
    "    Returns:\n",
    "        dict: Overlap statistics per string per quadrant\n",
    "    \"\"\"\n",
    "    # Initialize overlap statistics dictionary\n",
    "    quad_str_relevance_dict = {\n",
    "        quad: {\n",
    "            string: {\n",
    "                'count1': 0, \n",
    "                'count2': 0, \n",
    "                'overlap': 0, \n",
    "                'semantic_overlap': 0\n",
    "            } \n",
    "            for string in relevant_strings\n",
    "        }\n",
    "        for quad in set(ft_quadrants)\n",
    "    }\n",
    "    \n",
    "    # Calculate overlaps\n",
    "    for quad in set(ft_quadrants):\n",
    "        for string in relevant_strings:\n",
    "            for i, ft_acts in enumerate(top_activations1):\n",
    "                if ft_quadrants[i] == quad:\n",
    "                    act1 = get_token_strings(ft_acts)\n",
    "                    act2 = get_token_strings(top_activations2[i])\n",
    "                    \n",
    "                    # Check relevance for both activation sets\n",
    "                    act1_rel = False\n",
    "                    act2_rel = False\n",
    "                    \n",
    "                    if _is_relevant_activation(act1, string):\n",
    "                        quad_str_relevance_dict[quad][string]['count1'] += 1\n",
    "                        act1_rel = True\n",
    "                        \n",
    "                    if _is_relevant_activation(act2, string):\n",
    "                        quad_str_relevance_dict[quad][string]['count2'] += 1\n",
    "                        act2_rel = True\n",
    "                    \n",
    "                    # Calculate overlaps\n",
    "                    if act1_rel and act2_rel:\n",
    "                        quad_str_relevance_dict[quad][string]['overlap'] += 1\n",
    "                        \n",
    "                        # Check semantic overlap\n",
    "                        if any(activation_string in act2 for activation_string in act1):\n",
    "                            quad_str_relevance_dict[quad][string]['semantic_overlap'] += 1\n",
    "    \n",
    "    return quad_str_relevance_dict\n",
    "\n",
    "def _is_relevant_activation(activation_strings, target_string):\n",
    "    \"\"\"\n",
    "    Helper function to check if activation strings are relevant to target string.\n",
    "    \"\"\"\n",
    "    return (all(activation_string in target_string for activation_string in activation_strings) and\n",
    "            any(len(activation_string) > 1 for activation_string in activation_strings))"
   ]
  },

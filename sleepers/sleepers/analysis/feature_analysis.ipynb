    "import plotly.graph_objects as go\n",
    "import numpy as np\n",
    "\n",
    "def create_feature_barchart(ft_counts, quad_str_relevance_dict, relevant_strings):\n",
    "    # Get quadrants and calculate percentages\n",
    "    quadrants = list(ft_counts.keys())\n",
    "    \n",
    "    # Calculate percentages for each string in each quadrant\n",
    "    string_percentages = []\n",
    "    other_active_percentages = []\n",
    "    dead_percentages = []\n",
    "    \n",
    "    # Muted color palette\n",
    "    colors = {\n",
    "        'dead': '#E6B0AA',  # muted pink\n",
    "        'deployment': '#A2D5F2',  # muted blue\n",
    "        'hate': '#C3B1E1',  # muted purple\n",
    "        'other': '#C8E6C9'  # muted green\n",
    "    }\n",
    "    \n",
    "    for quad in quadrants:\n",
    "        total_features = ft_counts[quad]['dead'] + ft_counts[quad]['alive']\n",
    "        n_alive = ft_counts[quad]['alive']\n",
    "        \n",
    "        # Calculate dead feature percentage\n",
    "        dead_percent = (ft_counts[quad]['dead'] / total_features) * 100\n",
    "        dead_percentages.append(dead_percent)\n",
    "        \n",
    "        quad_percentages = []\n",
    "        # Calculate percentage for each string (as % of total features, not just active)\n",
    "        for string in relevant_strings:\n",
    "            percentage = (quad_str_relevance_dict[quad][string] / total_features) * 100\n",
    "            quad_percentages.append(percentage)\n",
    "            \n",
    "        # Calculate remaining active features percentage\n",
    "        total_string_related = sum(quad_str_relevance_dict[quad].values())\n",
    "        other_active = ((n_alive - total_string_related) / total_features) * 100\n",
    "        other_active_percentages.append(other_active)\n",
    "        \n",
    "        string_percentages.append(quad_percentages)\n",
    "    \n",
    "    string_percentages = np.array(string_percentages)\n",
    "    \n",
    "    fig = go.Figure()\n",
    "    \n",
    "    \n",
    "    \n",
    "    # Add trace for each string\n",
    "    for i, string in enumerate(relevant_strings):\n",
    "        y_values = string_percentages[:, i]\n",
    "        base = 0 if i == 0 else (string_percentages[:, :i].sum(axis=1))\n",
    "        \n",
    "        color = colors['deployment'] if 'DEPLOYMENT' in string else colors['hate']\n",
    "        \n",
    "        fig.add_trace(go.Bar(\n",
    "            name=string.strip(),\n",
    "            x=quadrants,\n",
    "            y=y_values,\n",
    "            base=base,\n",
    "            marker_color=color,\n",
    "            text=np.round(y_values, 1).astype(str) + '%',\n",
    "            textposition='inside',\n",
    "            hovertemplate=\"Quadrant: %{x}<br>\" +\n",
    "                         f\"{string.strip()}: \" + \"%{y:.1f}%<br>\" +\n",
    "                         \"<extra></extra>\"\n",
    "        ))\n",
    "    \n",
    "    # Add trace for other active features\n",
    "    fig.add_trace(go.Bar(\n",
    "        name='Other Active Features',\n",
    "        x=quadrants,\n",
    "        y=other_active_percentages,\n",
    "        base=string_percentages.sum(axis=1),\n",
    "        marker_color=colors['other'],\n",
    "        text=np.round(other_active_percentages, 1).astype(str) + '%',\n",
    "        textposition='inside',\n",
    "        hovertemplate=\"Quadrant: %{x}<br>\" +\n",
    "                     \"Other Active Features: %{y:.1f}%<br>\" +\n",
    "                     \"<extra></extra>\"\n",
    "    ))\n",
    "\n",
    "    # Add dead features trace\n",
    "    fig.add_trace(go.Bar(\n",
    "        name='Dead Features',\n",
    "        x=quadrants,\n",
    "        y=dead_percentages,\n",
    "        base = string_percentages.sum(axis=1) + other_active_percentages,\n",
    "        marker_color=colors['dead'],\n",
    "        text=np.round(dead_percentages, 1).astype(str) + '%',\n",
    "        textposition='inside',\n",
    "        hovertemplate=\"Quadrant: %{x}<br>\" +\n",
    "                     \"Dead Features: %{y:.1f}%<br>\" +\n",
    "                     \"<extra></extra>\"\n",
    "    ))\n",
    "    \n",
    "    # Update layout\n",
    "    fig.update_layout(\n",
    "        title={\n",
    "            'text': 'Feature Distribution Across Quadrants',\n",
    "            'font': {'size': 20}\n",
    "        },\n",
    "        yaxis_title='Percentage of Total Features',\n",
    "        barmode='stack',\n",
    "        showlegend=True,\n",
    "        hovermode='closest',\n",
    "        uniformtext=dict(mode='hide', minsize=10),\n",
    "        template='plotly_white',\n",
    "        legend=dict(\n",
    "            yanchor=\"top\",\n",
    "            y=0.99,\n",
    "            xanchor=\"right\",\n",
    "            x=1.2\n",
    "        ),\n",
    "        # Add a light grid\n",
    "        yaxis=dict(\n",
    "            gridcolor='rgba(0,0,0,0.1)',\n",
    "            gridwidth=1\n",
    "        ),\n",
    "        plot_bgcolor='white'\n",
    "    )\n",
    "    \n",
    "    # Ensure y-axis goes to 100%\n",
    "    fig.update_yaxes(range=[0, 100])\n",
    "    \n",
    "    return fig"
   ]
